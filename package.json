{
  "name": "ws-iconv",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/ws-iconv#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git"
  },
  "workspaces": [
    "packages/@lazy-node/*",
    "packages/@lazy-iconv/*",
    "packages/*",
    "packages/@bluelovers/*",
    "!**/test/**"
  ],
  "scripts": {
    "review:all": "yarn-tool ws run review --concurrency 1",
    "review:since": "pnpm run review:all -- --since",
    "coverage:all": "yarn-tool ws run coverage --concurrency 1",
    "coverage:since": "pnpm run coverage:all -- --since",
    "lint:all": "yarn-tool ws run lint --concurrency 1",
    "lint:since": "pnpm run lint:all -- --since",
    "pretest": "echo pretest",
    "test": "pnpm run test:since",
    "test:all": "yarn-tool ws run test --concurrency 1",
    "test:jest:clearCache": "jest --clearCache",
    "test:since": "pnpm run test:all -- --since",
    "test:snapshot:all": "yarn-tool ws run test:snapshot --concurrency 1",
    "test:snapshot:since": "pnpm run test:snapshot:all -- --since",
    "test:tsd:all": "yarn-tool ws run test:tsd --concurrency 1",
    "test:tsd:since": "pnpm run test:tsd:all -- --since",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:reset-lockfile": "yarn-tool install --reset-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build:all": "lerna run build --concurrency 1",
    "build:since": "pnpm run build:all -- --since",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w yarn-tool lerna ynpx ts-node ts-jest jest typescript@next",
    "ci:install:pnpm": "pnpm install --frozen-lockfile && pnpm add -w yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:install:yarn": "yarn install --frozen-lockfile && yarn add -W yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:build": "echo ci:build",
    "lerna:publish": "lerna publish",
    "lerna:publish:yes": "lerna publish --yes --bump patch",
    "lerna:publish:yes:force": "lerna publish --no-private --yes --bump patch --force-publish",
    "lerna:publish:yes:major": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump major && pnpm run postpublishOnly",
    "lerna:publish:yes:minor": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump minor && pnpm run postpublishOnly",
    "lerna:publish:yes:patch": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump patch && pnpm run postpublishOnly",
    "ws:fix-all": "yarn-tool fix-all --overwriteHostedGitInfo",
    "ws:fix-all:addStaticFiles": "node --run ws:fix-all -- --addStaticFiles",
    "ws:fix-all:resetStaticFiles": "node --run ws:fix-all -- --resetStaticFiles",
    "preversion": "pnpm run test",
    "version": "echo workspaces version",
    "postversion": "yt fix-all",
    "prepublish": "echo workspaces prepublish",
    "prepublish:lockfile": "ynpx sync-lockfile .",
    "prepare": "echo prepare",
    "prepare:fix-ws-links": "echo skip fix-ws-links (yarn-only)",
    "prepublishOnly": "echo workspaces prepublishOnly",
    "prepublishOnly:lerna": "echo workspaces prepublishOnly:lerna",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:lockfile": "ynpx --quiet sync-lockfile",
    "prepublishOnly:root": "pnpm run prepublishOnly:check-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo workspaces publish",
    "postpublish": "echo workspaces postpublish",
    "postpublish_": "git subtree push --prefix=packages/fs-iconv node-fs-iconv master && git subtree push --prefix=packages/iconv-jschardet node-iconv-jschardet master",
    "postpublishOnly": "pnpm run postpublishOnly:ws-root-changelog & echo postpublishOnly",
    "postpublishOnly:ws-root-changelog": "ynpx ws-root-changelog & git add ./CHANGELOG.md & git commit ./CHANGELOG.md -m \"chore(changelog): update changelog toc in workspaces root\" & echo update changelog toc in workspaces root",
    "ncu": "pnpm run ncu:ws",
    "ncu:ws": "yarn-tool ncu -u --AA",
    "ncu:root": "yarn-tool ncu -u",
    "sort-package-json": "pnpm run sort-package-json:root && pnpm run sort-package-json:ws",
    "sort-package-json:root": "yarn-tool sort",
    "sort-package-json:ws": "yarn-tool ws sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "resolutions": {},
  "dependencies": {
    "@bluelovers/conventional-changelog-bluelovers": "^5.0.30",
    "@bluelovers/jest-config": "^1.1.20",
    "picomatch": "^4.0.7",
    "tslib": "^2.9.1",
    "whatwg-encoding": "^3.1.1"
  },
  "devDependencies": {
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/bluebird": "^3.5.42",
    "@types/fs-extra": "^11.0.4",
    "@types/html-encoding-sniffer": "^3.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonfile": "^6.1.4",
    "@types/lodash": "^4.17.27",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.11",
    "@types/picomatch": "^4.0.3",
    "@yarn-tool/require-resolve": "*",
    "@yarn-tool/ws-find-up-paths": "^1.0.35",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "undici-types": "^8.13.1"
  },
  "peerDependencies": {
    "lerna": ">=6 <7"
  }
}
