{
  "name": "extrastat2",
  "version": "4.2.39",
  "description": "解析 fs.Stat 提供 MIME 類型、擁有者名稱、群組名稱和可讀權限 (Resolve fs.Stat to mimetype, ownername, groupname, and human-readable permissions)",
  "keywords": [
    "MIME",
    "mimetype",
    "Content-Type",
    "/etc/group",
    "/etc/passwd",
    "stat",
    "permissions",
    "uid",
    "gid",
    "groups",
    "fs.stat",
    "fs"
  ],
  "homepage": "https://github.com/bluelovers/ws-iconv/tree/master/packages/extrastat2#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git",
    "directory": "packages/extrastat2"
  },
  "license": "BSD-3-Clause",
  "author": "Colten Jackson",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "yarn run test -- --coverage",
    "test": "jest",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "yarn run test:jest -- --coverage",
    "test:jest:snapshot": "yarn run test:jest -- -u",
    "test:snapshot": "yarn run test -- -u",
    "test:tsd": "ynpx tsd",
    "preversion": "yarn run test",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "yarn run ncu && yarn run sort-package-json",
    "ncu": "ynpx --quiet yarn-tool -- ncu -u",
    "sort-package-json": "ynpx --quiet yarn-tool -- sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "path-parents": "^1.0.35",
    "stat-mode": "^1.0.0",
    "ts-type": "^3.0.1",
    "tslib": "^2"
  },
  "gitHead": "e6dea90eaa22e331d180711d3ec4c4d430fce071"
}
