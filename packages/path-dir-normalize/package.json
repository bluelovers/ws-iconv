{
  "name": "path-dir-normalize",
  "version": "1.0.33",
  "description": "目錄路徑規範化工具 - 確保目錄路徑以正確的分隔符結尾 dir normalize with end of path.sep",
  "keywords": [],
  "homepage": "https://github.com/bluelovers/ws-iconv/tree/master/packages/path-dir-normalize#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git",
    "directory": "packages/path-dir-normalize"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "ynpx nyc pnpm run test",
    "lint": "ynpx eslint **/*.ts",
    "test": "jest",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes --cd-version patch",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "ynpx sync-lockfile .",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "ynpx sort-package-json ./package.json",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "path-strip-sep": "^1.0.21",
    "tslib": "^2.9.1",
    "upath2": "^3.1.25"
  },
  "gitHead": "6c258437d14e2d37d1fb08068fa60833ce6d389b"
}
