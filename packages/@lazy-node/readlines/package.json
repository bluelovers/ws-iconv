{
  "name": "@lazy-node/readlines",
  "version": "3.0.7",
  "description": "逐行讀取檔案，無需將整個檔案載入記憶體 (Read file line by line without buffering the whole file in memory)",
  "keywords": [
    "lazy-node",
    "readlines",
    "line-by-line",
    "file-reader",
    "synchronous",
    "sync",
    "buffer",
    "line-reader",
    "text-file",
    "large-file",
    "memory-efficient",
    "stream-alternative",
    "fs",
    "filesystem",
    "read",
    "line",
    "reader",
    "linereader",
    "readfile",
    "linebyline",
    "readline",
    "create-by-yarn-tool",
    "create-by-tsdx"
  ],
  "homepage": "https://github.com/bluelovers/ws-iconv/tree/master/packages/@lazy-node/readlines#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git",
    "directory": "packages/@lazy-node/readlines"
  },
  "license": "MIT",
  "author": "Yoan Arnaudov <jonidev@gmail.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./class": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "main": "dist/index.cjs",
  "unpkg": "dist/index.umd.production.min.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "pretest": "echo pretest",
    "test": "node --run test:node --",
    "test:jest": "node --run test:node --",
    "test:jest:coverage": "node --run test:node:coverage --",
    "test:jest:snapshot": "pnpm run test",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:node:coverage": "node --run test:node:bin:coverage -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "posttest": "pnpm run build",
    "build": "pnpm run build:tsdx && pnpm run build:dts:bundle",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "pnpm run build:dts:copy && pnpm run build:dts:tsc:emit && pnpm run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-node/util-buffer": "^1.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "6c258437d14e2d37d1fb08068fa60833ce6d389b"
}
