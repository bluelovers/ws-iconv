{
  "name": "fs-target-file",
  "version": "1.0.26",
  "description": "",
  "homepage": "https://github.com/bluelovers/ws-iconv/tree/master/packages/fs-target-file#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git",
    "directory": "packages/fs-target-file"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "node --run test:node --",
    "test:jest": "ynpx --quiet jest -- --coverage --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "preversion": "pnpm run prepublishOnly:check-bin && pnpm run test",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "ts-type": "^3.0.21",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4"
  },
  "gitHead": "6c258437d14e2d37d1fb08068fa60833ce6d389b"
}
