{
  "name": "path-is-same",
  "version": "1.0.32",
  "description": "路徑比較工具 - 檢查多個路徑是否指向相同的檔案或目錄",
  "homepage": "https://github.com/bluelovers/ws-iconv/tree/master/packages/path-is-same#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-iconv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-iconv.git",
    "directory": "packages/path-is-same"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "coverage": "ynpx nyc pnpm run test",
    "lint": "ynpx eslint **/*.ts",
    "test": "node --run test:node --",
    "test:jest": "node --run test:node --",
    "test:jest:coverage": "node --run test:node:coverage --",
    "test:jest:snapshot": "pnpm run test",
    "test:mocha": "ynpx mocha --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:node:coverage": "node --run test:node:bin:coverage -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes --bump patch",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "ynpx sync-lockfile .",
    "postpublish_": "git commit -m \"chore(release): publish & git push & echo postpublish\" .",
    "ncu": "ynpx yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "tslib": "^2.9.1",
    "upath2": "^3.1.27"
  },
  "gitHead": "e6dea90eaa22e331d180711d3ec4c4d430fce071"
}
